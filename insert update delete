#include <stdio.h>
int main() {
    int a[100], n, i, p, val;
    printf("Size: ");
    scanf("%d", &n);
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nCheck pos: ");
    scanf("%d", &p);
    if(p >= 1 && p <= n)
        printf("%d\n", a[p-1]);

    printf("Change pos: ");
    scanf("%d", &p);
    if(p >= 1 && p <= n) {
        printf("New val: ");
        scanf("%d", &val);
        a[p-1] = val;
    }

    printf("Remove pos: ");
    scanf("%d", &p);
    if(p >= 1 && p <= n) {
        for(i = p-1; i < n-1; i++)
            a[i] = a[i+1];
        n--;
    }

    // Final output
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

#include <stdio.h>

int main() {
    int arr[100], size, i, pos, newVal;

    // Input size
    printf("Enter size of array: ");
    scanf("%d", &size);

    // Input elements
    printf("Enter elements:\n");
    for(i = 0; i < size; i++) {
        scanf("%d", &arr[i]);
    }

    // Display array
    printf("Array: ");
    for(i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }

    // Display element at position
    printf("\nEnter position to display: ");
    scanf("%d", &pos);

    if(pos < 1 || pos > size) {
        printf("Invalid position\n");
    } else {
        printf("Element = %d\n", arr[pos - 1]);
    }

    // Update element
    printf("Enter position to update: ");
    scanf("%d", &pos);

    if(pos < 1 || pos > size) {
        printf("Invalid position\n");
    } else {
        printf("Enter new value: ");
        scanf("%d", &newVal);
        arr[pos - 1] = newVal;
    }

    // Display after update
    printf("Array after update: ");
    for(i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }

    // Delete element
    printf("\nEnter position to delete: ");
    scanf("%d", &pos);

    if(pos < 1 || pos > size) {
        printf("Invalid position\n");
    } else {
        for(i = pos - 1; i < size - 1; i++) {
            arr[i] = arr[i + 1];
        }
        size--;
    }

    // Display after delete
    printf("Array after deletion: ");
    for(i = 0; i < size; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}

#include <stdio.h>
int main() {
    float s1, s2, s3, s4, s5, total, per;

    printf("Enter marks of 5 subjects (0-100): ");
    scanf("%f %f %f %f %f", &s1, &s2, &s3, &s4, &s5);

    if (s1 < 0 || s1 > 100 || s2 < 0 || s2 > 100 ||
        s3 < 0 || s3 > 100 || s4 < 0 || s4 > 100 ||
        s5 < 0 || s5 > 100) {
        printf("Invalid marks!");
        return 0;
    }

    total = s1 + s2 + s3 + s4 + s5;
    per = total / 5;

    printf("Total = %.2f\nPercentage = %.2f%%\n", total, per);

    if (per >= 90) printf("Grade: A");
    else if (per >= 75) printf("Grade: B");
    else if (per >= 60) printf("Grade: C");
    else if (per >= 40) printf("Grade: D");
    else printf("Result: Fail");

    return 0;
}

#include <stdio.h>

int main() {
    int n, i, sum;
    int arr[100];

    printf("Enter number of elements: ");
    scanf("%d", n);   // Error: Missing &

    printf("Enter elements:\n");
    for (i = 0; i <= n; i++) {   // Error: Off-by-one
        scanf("%d", &arr[i]);
    }

    for (i = 0; i < n; i++) {
